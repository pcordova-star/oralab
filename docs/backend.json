
{
  "entities": {
    "Booking": {
      "title": "Booking",
      "description": "Representa una solicitud de reserva de examen o retiro de kit.",
      "type": "object",
      "properties": {
        "firstName": { "type": "string" },
        "lastNameFather": { "type": "string" },
        "lastNameMother": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "phone": { "type": "string" },
        "address": { "type": "string" },
        "pickupAddress": { "type": "string", "description": "Dirección específica donde el motoboy retirará las muestras en modalidad home_kit." },
        "birthDate": { "type": "string", "format": "date" },
        "weight": { "type": "string" },
        "country": { "type": "string" },
        "region": { "type": "string" },
        "commune": { "type": "string" },
        "sex": { "type": "string", "enum": ["not_specified", "male", "female"] },
        "examType": { "type": "string", "enum": ["Lactulosa", "Fructosa", "Lactosa", "SIBO"] },
        "modality": { "type": "string", "enum": ["presential", "home_kit"] },
        "prevision": { "type": "string", "enum": ["fonasa", "isapre", "particular"] },
        "baseFee": { "type": "number" },
        "deliveryFee": { "type": "number" },
        "discount": { "type": "number" },
        "total": { "type": "number" },
        "scheduledDate": { "type": "string", "format": "date" },
        "scheduledTime": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "arrived", "in_progress", "completed", "cancelled", "rescheduled"] },
        "testLogs": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "stepName": { "type": "string" },
              "timestamp": { "type": "string", "format": "date-time" }
            }
          }
        },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["firstName", "lastNameFather", "email", "phone", "examType", "modality", "scheduledDate", "scheduledTime", "status", "total"]
    },
    "Mail": {
      "title": "Mail",
      "description": "Colección utilizada por la extensión Trigger Email para enviar notificaciones.",
      "type": "object",
      "properties": {
        "to": { "type": "string" },
        "message": {
          "type": "object",
          "properties": {
            "subject": { "type": "string" },
            "text": { "type": "string" },
            "html": { "type": "string" }
          }
        }
      }
    },
    "Quotation": {
      "title": "Quotation",
      "description": "Representa una cotización comercial de equipos o servicios Sunvou.",
      "type": "object",
      "properties": {
        "clientName": { "type": "string" },
        "clientCompany": { "type": "string" },
        "clientEmail": { "type": "string", "format": "email" },
        "clientPhone": { "type": "string" },
        "exchangeRate": { "type": "number" },
        "status": { "type": "string", "enum": ["pending", "sent", "accepted", "rejected"] },
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "description": { "type": "string" },
              "quantity": { "type": "number" },
              "unitPrice": { "type": "number" },
              "unitPriceUSD": { "type": "number" }
            }
          }
        },
        "total": { "type": "number" },
        "notes": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["clientName", "clientEmail", "items", "total", "status", "exchangeRate", "createdAt"]
    },
    "AgreementRequest": {
      "title": "AgreementRequest",
      "description": "Solicitud de convenio institucional o para médicos.",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "institution": { "type": "string" },
        "phone": { "type": "string" },
        "message": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "email", "institution", "createdAt"]
    }
  },
  "auth": {
    "providers": [
      "anonymous",
      "google",
      "email"
    ]
  },
  "firestore": {
    "/bookings/{bookingId}": {
      "schema": "Booking",
      "description": "Colección de solicitudes de reserva."
    },
    "/mail/{mailId}": {
      "schema": "Mail",
      "description": "Trigger automático de correos electrónicos."
    },
    "/quotations/{quotationId}": {
      "schema": "Quotation",
      "description": "Colección de cotizaciones comerciales."
    },
    "/agreement_requests/{requestId}": {
      "schema": "AgreementRequest",
      "description": "Solicitudes de convenio de instituciones o médicos."
    }
  }
}
