
{
  "entities": {
    "Booking": {
      "title": "Booking",
      "description": "Representa una solicitud de reserva de examen o retiro de kit.",
      "type": "object",
      "properties": {
        "firstName": { "type": "string" },
        "lastNameFather": { "type": "string" },
        "lastNameMother": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "phone": { "type": "string" },
        "address": { "type": "string" },
        "birthDate": { "type": "string", "format": "date" },
        "diagnosis": { "type": "string" },
        "weight": { "type": "string" },
        "doctor": { "type": "string" },
        "country": { "type": "string" },
        "region": { "type": "string" },
        "commune": { "type": "string" },
        "sex": { "type": "string", "enum": ["not_specified", "male", "female"] },
        "examType": { "type": "string", "enum": ["Lactulosa", "Fructosa", "Lactosa"] },
        "modality": { "type": "string", "enum": ["presential", "home_kit"] },
        "scheduledDate": { "type": "string", "format": "date" },
        "scheduledTime": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "arrived", "in_progress", "completed", "cancelled", "rescheduled"] },
        "testLogs": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "stepName": { "type": "string" },
              "timestamp": { "type": "string", "format": "date-time" }
            }
          }
        },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["firstName", "lastNameFather", "email", "phone", "examType", "modality", "scheduledDate", "scheduledTime", "status"]
    },
    "Quotation": {
      "title": "Quotation",
      "description": "Representa una cotización comercial de equipos o servicios Sunvou.",
      "type": "object",
      "properties": {
        "clientName": { "type": "string" },
        "clientCompany": { "type": "string" },
        "clientEmail": { "type": "string", "format": "email" },
        "clientPhone": { "type": "string" },
        "exchangeRate": { "type": "number" },
        "status": { "type": "string", "enum": ["pending", "sent", "accepted", "rejected"] },
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "description": { "type": "string" },
              "quantity": { "type": "number" },
              "unitPrice": { "type": "number" },
              "unitPriceUSD": { "type": "number" }
            }
          }
        },
        "total": { "type": "number" },
        "notes": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["clientName", "clientEmail", "items", "total", "status", "exchangeRate", "createdAt"]
    },
    "Lead": {
      "title": "Lead",
      "description": "Contacto comercial desde la landing de Sunvou.",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "institution": { "type": "string" },
        "message": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "email", "message"]
    },
    "Investor": {
      "title": "Investor",
      "description": "Registro de inversión y aportes de capital.",
      "type": "object",
      "properties": {
        "realName": { "type": "string", "description": "Nombre real visible solo para admin." },
        "investorNumber": { "type": "number", "description": "Número secuencial para vista pública." },
        "amount": { "type": "number", "description": "Monto aportado en CLP." },
        "status": { "type": "string", "enum": ["confirmed", "pending"], "description": "Estado del aporte: confirmado o por confirmar." },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["realName", "investorNumber", "amount", "status", "createdAt"]
    },
    "ContractLead": {
      "title": "ContractLead",
      "description": "Registro de inversionistas que han completado el formulario y descargado el borrador de contrato.",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "rut": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "address": { "type": "string" },
        "amount": { "type": "number" },
        "equity": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "rut", "email", "amount", "createdAt"]
    }
  },
  "auth": {
    "providers": [
      "anonymous",
      "google",
      "email"
    ]
  },
  "firestore": {
    "/bookings/{bookingId}": {
      "schema": "Booking",
      "description": "Colección de solicitudes de reserva gestionadas por el administrador."
    },
    "/quotations/{quotationId}": {
      "schema": "Quotation",
      "description": "Colección de cotizaciones comerciales generadas por el representante Sunvou."
    },
    "/leads/{leadId}": {
      "schema": "Lead",
      "description": "Consultas comerciales recibidas por el representante."
    },
    "/investors/{investorId}": {
      "schema": "Investor",
      "description": "Colección de inversionistas gestionada por el Super Admin."
    },
    "/contract_leads/{leadId}": {
      "schema": "ContractLead",
      "description": "Colección de interesados que generaron borradores de contrato."
    }
  }
}
