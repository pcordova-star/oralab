rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Función de Administrador robusta
    function isAdmin() {
      return request.auth != null && 
             request.auth.token != null && 
             request.auth.token.email == 'admin@oralab.cl';
    }

    // Reglas para Contratos de Inversión
    match /contract_leads/{leadId} {
      // 1. Creación pública permitida
      allow create: if true;
      
      // 2. SEPARACIÓN DE LISTADO (Solución al error de permisos)
      // Puerta A: El administrador puede listar TODO sin filtros.
      allow list: if isAdmin();
      
      // Puerta B: El público puede listar solo si aplica el filtro exacto.
      // Usamos una condición que no interfiera con la query global del Admin.
      allow list: if request.query.status == 'fully_signed';
      
      // Lectura individual permitida para validación (ej. descarga de PDF)
      allow get: if true; 
      
      // Escritura solo para el Administrador
      allow write: if isAdmin();
    }

    // Reglas para Reservas de Pacientes
    match /bookings/{bookingId} {
      allow create: if true;
      allow read, write: if isAdmin();
    }

    // Reglas para Consultas Comerciales desde la Web
    match /leads/{leadId} {
      allow create: if true;
      allow read, write: if isAdmin();
    }

    // Reglas para Cotizaciones CRM
    match /quotations/{quotationId} {
      allow read, write: if isAdmin();
    }

    // Reglas para el Registro histórico de Inversionistas
    match /investors/{investorId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Regla de respaldo para cualquier otra ruta
    match /{document=**} {
      allow read, write: if isAdmin();
    }
  }
}