rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * CORE PHILOSOPHY:
     * This ruleset implements a Role-Based Access Control (RBAC) model optimized for clinical operations.
     * It distinguishes between staff members (Receptionists and TEENS) and public users (Patients).
     *
     * DATA STRUCTURE:
     * - /users: Staff profile information.
     * - /roles_...: Marker collections used for high-performance role verification via exists() checks.
     * - /patients, /appointments: Shared clinical data accessible by staff and created by public/anonymous users.
     * - /exam_sessions: Real-time session data managed primarily by TEENS staff.
     */

    // --- Helper Functions ---

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isReceptionist() {
      return isSignedIn() && exists(/databases/$(database)/documents/roles_receptionist/$(request.auth.uid));
    }

    function isTeens() {
      return isSignedIn() && exists(/databases/$(database)/documents/roles_teens/$(request.auth.uid));
    }

    function isStaff() {
      return isReceptionist() || isTeens();
    }

    function isExistingOwner(userId) {
      return resource != null && isOwner(userId);
    }

    // --- Collection Rules ---

    match /users/{userId} {
      allow get: if isStaff() || isOwner(userId);
      allow list: if isStaff();
      allow create: if isOwner(userId) && request.resource.data.id == userId;
      allow update: if isExistingOwner(userId) && request.resource.data.id == resource.data.id;
      allow delete: if isExistingOwner(userId);
    }

    match /roles_receptionist/{userId} {
      allow get: if isOwner(userId) || isReceptionist();
      // Permitimos la creación por el dueño para el registro inicial en el prototipo
      allow create: if isOwner(userId);
      allow update, delete: if false;
    }

    match /roles_teens/{userId} {
      allow get: if isOwner(userId) || isTeens();
      // Permitimos la creación por el dueño para el registro inicial en el prototipo
      allow create: if isOwner(userId);
      allow update, delete: if false;
    }

    match /patients/{patientId} {
      allow get, list: if isStaff();
      allow create: if isSignedIn();
      allow update: if isStaff() && resource != null;
      allow delete: if isStaff() && resource != null;
    }

    match /protocols/{protocolId} {
      allow get, list: if isStaff();
      allow create, update, delete: if false;
    }

    match /appointments/{appointmentId} {
      allow get, list: if isStaff();
      allow create: if isSignedIn();
      allow update: if isStaff() && resource != null;
      allow delete: if isStaff() && resource != null;
    }

    match /exam_sessions/{examSessionId} {
      allow get, list: if isStaff();
      allow create: if isTeens();
      allow update: if isTeens() && resource != null;
      allow delete: if isTeens() && resource != null;
    }
  }
}
