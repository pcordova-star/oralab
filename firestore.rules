rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Función de Administrador directa
    function isAdmin() {
      return request.auth != null && request.auth.token.email == 'admin@oralab.cl';
    }

    // Reglas para Contratos de Inversión (TOTALMENTE ABIERTAS PARA LECTURA PÚBLICA)
    // Se permite el acceso total de lectura para que el Dashboard sea igual al Landing.
    match /contract_leads/{leadId} {
      allow read, list, create: if true;
      allow update, delete: if isAdmin();
    }

    // Reglas para Registro de Inversionistas (TOTALMENTE ABIERTAS)
    match /investors/{investorId} {
      allow read, list, create: if true;
      allow write: if isAdmin();
    }

    // Reglas para Reservas de Pacientes
    match /bookings/{bookingId} {
      allow create: if true;
      allow read, write: if isAdmin();
    }

    // Reglas para Consultas Comerciales
    match /leads/{leadId} {
      allow create: if true;
      allow read, write: if isAdmin();
    }

    // Reglas para Cotizaciones (CRM)
    match /quotations/{quotationId} {
      allow read, write: if isAdmin();
    }

    // Regla de respaldo estricta
    match /{document=**} {
      allow read, write: if isAdmin();
    }
  }
}