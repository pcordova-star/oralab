rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * CORE PHILOSOPHY:
     * Role-Based Access Control (RBAC) optimized for clinical operations.
     * Uses marker collections (roles_...) for high-performance exists() checks.
     * Hardcoded Super Admin bypass for control@pcgoperacion.com
     */

    // --- Helper Functions ---

    function isSignedIn() {
      return request.auth != null;
    }

    function isSuperAdmin() {
      return isSignedIn() && request.auth.token.email == "control@pcgoperacion.com";
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isReceptionist() {
      return isSuperAdmin() || (isSignedIn() && exists(/databases/$(database)/documents/roles_receptionist/$(request.auth.uid)));
    }

    function isTeens() {
      return isSuperAdmin() || (isSignedIn() && exists(/databases/$(database)/documents/roles_teens/$(request.auth.uid)));
    }

    function isStaff() {
      return isReceptionist() || isTeens() || isSuperAdmin();
    }

    function isExistingOwner(userId) {
      return resource != null && isOwner(userId);
    }

    // --- Collection Rules ---

    match /users/{userId} {
      allow get: if isStaff() || isOwner(userId);
      allow list: if isStaff();
      allow create: if isOwner(userId) && request.resource.data.id == userId;
      allow update: if (isExistingOwner(userId) || isSuperAdmin()) && request.resource.data.id == resource.data.id;
      allow delete: if isExistingOwner(userId) || isSuperAdmin();
    }

    match /roles_receptionist/{userId} {
      allow get: if isOwner(userId) || isReceptionist() || isSuperAdmin();
      allow create, update: if isOwner(userId) || isSuperAdmin();
      allow delete: if isSuperAdmin();
    }

    match /roles_teens/{userId} {
      allow get: if isOwner(userId) || isTeens() || isSuperAdmin();
      allow create, update: if isOwner(userId) || isSuperAdmin();
      allow delete: if isSuperAdmin();
    }

    match /patients/{patientId} {
      allow get, list: if isStaff();
      allow create: if isSignedIn();
      allow update: if isStaff() && resource != null;
      allow delete: if isStaff() && resource != null;
    }

    match /protocols/{protocolId} {
      allow get, list: if isStaff();
      allow create, update, delete: if isSuperAdmin();
    }

    match /appointments/{appointmentId} {
      allow get, list: if isStaff();
      allow create: if isSignedIn();
      allow update: if isStaff() && resource != null;
      allow delete: if isStaff() && resource != null;
    }

    match /exam_sessions/{examSessionId} {
      allow get, list: if isStaff();
      allow create: if isTeens() || isSuperAdmin();
      allow update: if (isTeens() || isSuperAdmin()) && resource != null;
      allow delete: if (isTeens() || isSuperAdmin()) && resource != null;
    }
  }
}