rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Función de Administrador directa
    function isAdmin() {
      return request.auth != null && request.auth.token.email == 'admin@oralab.cl';
    }

    // Reglas para Contratos de Inversión (PÚBLICA - Sin filtros de servidor)
    match /contract_leads/{leadId} {
      allow create: if true;
      allow read, list: if true; 
      allow write: if isAdmin();
    }

    // Reglas para Reservas de Pacientes
    match /bookings/{bookingId} {
      allow create: if true;
      allow read, write: if isAdmin();
    }

    // Reglas para Consultas Comerciales
    match /leads/{leadId} {
      allow create: if true;
      allow read, write: if isAdmin();
    }

    // Reglas para Cotizaciones (CRM)
    match /quotations/{quotationId} {
      allow read, write: if isAdmin();
    }

    // Reglas para Registro de Inversionistas
    match /investors/{investorId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Regla de respaldo
    match /{document=**} {
      allow read, write: if isAdmin();
    }
  }
}