
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // REGLAS ABIERTAS PARA PRODUCCIÓN - ACTUALIZADO: 2024-05-26T12:00:00Z
    // Nota: Estas reglas permiten acceso total mientras se completa la propagación del dominio.
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
