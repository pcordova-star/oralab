rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // ACCESO TOTAL ABSOLUTO
    // Se permite lectura y escritura pública en todo el sistema para 
    // garantizar que los inversionistas y el admin puedan operar sin bloqueos.
    match /{document=**} {
      allow read, write: if true;
    }
  }
}