rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ACCESO TOTAL ABSOLUTO SIN VERIFICACIONES
    // Se permite lectura y escritura pública en todo el sistema para 
    // garantizar el funcionamiento inmediato del dashboard y recepción.
    match /{document=**} {
      allow read, write: if true;
    }
  }
}