rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Función de Administrador infalible y directa
    function isAdmin() {
      return request.auth != null && request.auth.token.email == 'admin@oralab.cl';
    }

    // Reglas para Contratos de Inversión
    match /contract_leads/{leadId} {
      // 1. Creación pública permitida para nuevos interesados
      allow create: if true;
      
      // 2. SEPARACIÓN FÍSICA DE PERMISOS DE LISTADO
      // Puerta A: El administrador puede listar TODO sin filtros.
      allow list: if isAdmin();
      
      // Puerta B: El público puede listar SOLO si aplica el filtro de 'fully_signed'.
      allow list: if request.query.status == 'fully_signed';
      
      // Lectura individual permitida para validación (ej. descarga de PDF)
      allow get: if true; 
      
      // Escritura (validar pagos, borrar, etc.) solo para el Administrador
      allow write: if isAdmin();
    }

    // Reglas para Reservas de Pacientes
    match /bookings/{bookingId} {
      allow create: if true;
      allow read, write: if isAdmin();
    }

    // Reglas para Consultas Comerciales desde la Web
    match /leads/{leadId} {
      allow create: if true;
      allow read, write: if isAdmin();
    }

    // Reglas para Cotizaciones CRM
    match /quotations/{quotationId} {
      allow read, write: if isAdmin();
    }

    // Reglas para el Registro histórico de Inversionistas
    match /investors/{investorId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Regla de respaldo para cualquier otra ruta
    match /{document=**} {
      allow read, write: if isAdmin();
    }
  }
}