rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * CORE PHILOSOPHY:
     * Role-Based Access Control (RBAC) optimized for clinical operations.
     * Uses marker collections (roles_...) for high-performance exists() checks.
     */

    // --- Helper Functions ---

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isReceptionist() {
      return isSignedIn() && exists(/databases/$(database)/documents/roles_receptionist/$(request.auth.uid));
    }

    function isTeens() {
      return isSignedIn() && exists(/databases/$(database)/documents/roles_teens/$(request.auth.uid));
    }

    function isStaff() {
      return isReceptionist() || isTeens();
    }

    function isExistingOwner(userId) {
      return resource != null && isOwner(userId);
    }

    // --- Collection Rules ---

    match /users/{userId} {
      allow get: if isStaff() || isOwner(userId);
      allow list: if isStaff();
      allow create: if isOwner(userId) && request.resource.data.id == userId;
      allow update: if isExistingOwner(userId) && request.resource.data.id == resource.data.id;
      allow delete: if isExistingOwner(userId);
    }

    // Role markers: crucial for RBACexists() checks.
    // Allow owner to create/update to ensure the marker exists after registration.
    match /roles_receptionist/{userId} {
      allow get: if isOwner(userId) || isReceptionist();
      allow create, update: if isOwner(userId);
      allow delete: if false;
    }

    match /roles_teens/{userId} {
      allow get: if isOwner(userId) || isTeens();
      allow create, update: if isOwner(userId);
      allow delete: if false;
    }

    match /patients/{patientId} {
      allow get, list: if isStaff();
      allow create: if isSignedIn();
      allow update: if isStaff() && resource != null;
      allow delete: if isStaff() && resource != null;
    }

    match /protocols/{protocolId} {
      allow get, list: if isStaff();
      allow create, update, delete: if false;
    }

    match /appointments/{appointmentId} {
      allow get, list: if isStaff();
      allow create: if isSignedIn();
      allow update: if isStaff() && resource != null;
      allow delete: if isStaff() && resource != null;
    }

    match /exam_sessions/{examSessionId} {
      allow get, list: if isStaff();
      allow create: if isTeens();
      allow update: if isTeens() && resource != null;
      allow delete: if isTeens() && resource != null;
    }
  }
}
