rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // REGLAS TOTALMENTE ABIERTAS PARA EMERGENCIA Y CONFIGURACIÓN INICIAL
    // Última actualización para forzar propagación: 2024-05-25T01:10:00Z
    match /{document=**} {
      allow read, write: if true;
    }
  }
}