
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // REGLAS DE SEGURIDAD ORALAB
    // Última actualización: 2026-05-24T17:30:00Z
    
    // Permitir acceso total a la colección de reservas para desarrollo y administración.
    // Esto permite que el panel de recepción (Administrador) liste y actualice estados.
    match /bookings/{bookingId} {
      allow read, write: if true;
    }

    // Regla global de respaldo para otros servicios.
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
